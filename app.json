{
  "expo": {
    "name": "CNPortfolio",
    "slug": "cnportfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F3F1EC",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F1EC"
    },
    "android": {
      "package": "rw.ac.ines.ug2527889.cnportfolio",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F5F4A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "CNPortfolio uses the camera only to take your profile photo. The photo stays on this phone.",
          "photosPermission": "CNPortfolio uses your photos only to choose a profile picture. The picture stays on this phone.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2748e702-3f6a-4619-8140-de3d633e5706"
      }
    },
    "owner": "ckristian"
  }
}
